import sys
from awsglue.transforms import *
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from awsglue.context import GlueContext
from awsglue.job import Job
from datetime import datetime
import pyspark.sql.functions as F

## @params: [JOB_NAME, source_path, target_path]
args = getResolvedOptions(sys.argv, ['JOB_NAME', 'source_path', 'target_path'])

sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)
job.init(args['JOB_NAME'], args)

# Get current date and format months/days with zero-padding (e.g., '05' or '10')
now = datetime.now()
year = str(now.year)
month = f"{now.month:02d}"
day = f"{now.day:02d}"

source_path = args.get("source_path")
target_path = args.get("target_path")

# Constructs path: s3://bucket/path/year=2026/month=10/day=15
actual_source_path = f"{source_path}/year={year}/month={month}/day={day}"

# Read the CSV data
Source_df = spark.read.format("csv") \
    .option("header", True) \
    .option("inferSchema", True) \
    .load(actual_source_path)

# 1. Fixed typo: withColumn
# 2. Fixed logic: F.lit(month) instead of F.lit("month")
Source_df = Source_df \
    .withColumn("year", F.lit(year)) \
    .withColumn("month", F.lit(month)) \
    .withColumn("day", F.lit(day))


#Transfom the data as needed

Source_df = Source_df.dropDuplicates(["customer_name"])

transformed_df = Source_df.withColumn("city",F.upper(F.col("city"))).withColumn("region",F.upper(F.col("region"))).withColumn("registration_date",F.to_date(F.col("registration_date"),"yyyy-MM-dd")).withColumn("customer_name",F.trim(F.col("customer_name")))
transformed_df = transformed_df.filter(F.col("customer_status") == 'ACTIVE')


transformed_df = transformed_df.withColumn(
    "Custom_age",
    F.floor(
        F.months_between(
            F.current_date(),
            F.to_date(F.col("date_of_birth"), "yyyy-MM-dd")
        ) / 12
    )
)



# Write out as Parquet (Removed .option("Header", True) as Parquet stores metadata natively)
transformed_df.write.mode("overwrite") \
    .format("csv") \
    .partitionBy("year", "month", "day") \
    .option("header",True)\
    .option("partitionOverwriteMode", "dynamic")\
    .save(target_path)

job.commit()
