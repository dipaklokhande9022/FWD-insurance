import sys
from awsglue.transforms import *
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from awsglue.context import GlueContext
from awsglue.job import Job
from datetime import datetime
import pyspark.sql.functions as f


## @params: [JOB_NAME]
args = getResolvedOptions(sys.argv, ['JOB_NAME','source_path', 'target_path'])

sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)
job.init(args['JOB_NAME'], args)

now = datetime.now()
year = now.year
month = now.month
day = now.day

source_folder = args.get["source_path"]
target_path = args.get["target_path"]

policy_path = f"{source_folder}/policy/year={year}/month={month}/day={day}/"
insurance_product_path = f"{source_folder}/insurance_product/year={year}/month={month}/day={day}/"
agent_path = f"{source_folder}/agent/year={year}/month={month}/day={day}/"

def read_csv_from_s3(path):
    return(
        spark.read.fomrat("csv").option("header",True).option("inferSchema",True).load(path)
    )

policy_df = read_csv_from_s3(policy_path)
insurance_product_df = read_csv_from_s3(insurance_product_path)
agent_df = read_csv_from_s3(agent_path)
job.commit()